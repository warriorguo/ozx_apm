# OZX APM Server Configuration
# Copy this file to config.yaml and modify as needed

# SDK Ingestion Server (receives events from Unity SDK)
server:
  enabled: true        # Set to false for admin-only deployment
  host: "0.0.0.0"
  port: 8080
  read_timeout: "30s"
  write_timeout: "30s"

# Admin Server (API for admin dashboard)
admin_server:
  enabled: true        # Set to false for server-only deployment
  host: "0.0.0.0"
  port: 8081
  read_timeout: "30s"
  write_timeout: "30s"
  allowed_origins:
    - "*"
  # APM-14 privacy deletion API: disabled unless a token is set. Set it through
  # the environment (OZX_ADMIN_PRIVACY_TOKEN, a secret), not in this file.
  # privacy_token: ""
  # APM-12 imports of exchange rates and ad network reports: disabled unless a
  # token is set (OZX_ADMIN_OPS_TOKEN, a secret).
  # ops_token: ""

# Operations data (APM-12, RELEASE.md). Every key can also be set as
# OZX_OPS_<KEY> (OZX_OPS_CONTEXT_KEYS is comma separated).
ops:
  # Game context keys kept with an ops event (all others are dropped at ingest).
  context_keys: [runId, chapter, levelId, room, roomId, revivesUsed]
  # A header a trusted CDN/proxy in front of the ingest server sets to the
  # client's ISO country (Cloudflare: CF-IPCountry). Empty: not used; the
  # SDK's country (the device's region setting) is kept instead.
  country_header: ""

# ClickHouse database configuration
# Can also be configured via DATABASE_URL environment variable:
#   DATABASE_URL=clickhouse://user:password@host:port/database
# DATABASE_URL takes precedence over the settings below
clickhouse:
  host: "localhost"
  port: 9000
  database: "ozx_apm"
  username: "default"
  password: ""
  # Batch concurrent ingest requests into fewer parts (async_insert=1,
  # wait_for_async_insert=1). Adds up to ~200ms latency per request.
  # Verified on ClickHouse 23.8 and 24.1. See RELEASE.md.
  async_insert: false

auth:
  enabled: false
  app_keys:
    # Add your app keys here
    # "your-app-key": "Your App Name"

ratelimit:
  enabled: true
  requests_per_min: 1000

# Alerting (APM-8, RELEASE.md). Every key can also be set as OZX_ALERT_<KEY>
# (OZX_ALERT_ENABLED, OZX_ALERT_WEBHOOK_URL, ...). Enable it on ONE deployment.
# The webhook URL is a secret: prefer the environment variable.
alert:
  enabled: false
  webhook_url: ""
  webhook_format: generic          # generic | slack | feishu
  admin_base_url: ""               # e.g. https://apm-admin.local.playquota.com (links in alerts)
  interval: 60s
  include_dev_builds: false
  new_issue_max_per_cycle: 10
  new_issue_max_per_hour: 30
  new_issue_window: 26h
  sweep_interval: 6h
  crash_rate_window: 1h
  crash_rate_baseline_window: 24h
  crash_rate_check_interval: 5m
  crash_rate_min_sessions: 50
  crash_rate_min_crashed_sessions: 5
  crash_rate_min_rate: 0.005
  crash_rate_factor: 2.0
  crash_rate_cooldown: 6h
  startup_enabled: true
  startup_window: 168h
  startup_check_interval: 1h
  startup_min_samples: 100
  startup_increase: 0.2
  startup_min_delta_ms: 100
